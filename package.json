{
  "name": "scrim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hide whole topics (AI, work, software/IT, NSFW, your own) across feeds, block sites, and tame YouTube.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "update": "git pull --ff-only && pnpm install --frozen-lockfile && wxt build",
    "bench": "vitest run --config vitest.bench.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@12.14.0"
}
